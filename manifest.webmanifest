    "standalone",
    "minimal-ui"
  ],
  "background_color": "#07090c",
  "theme_color": "#07090c",
  "orientation": "portrait",
  "categories": [
    "entertainment",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
